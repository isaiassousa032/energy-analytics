# Copiado para .env por .devcontainer/setup.py (os CHANGE_ME_* viram segredos aleatórios).
# Nunca versione o .env.

# Perfil do Compose: dev (Codespaces) ou prod (VM Azure)
COMPOSE_PROFILES=dev

AIRFLOW_UID=50000
AIRFLOW_PORT=8080

POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
AIRFLOW_FERNET_KEY=CHANGE_ME_FERNET
AIRFLOW_JWT_SECRET=CHANGE_ME_JWT

# --- Produção (VM Azure): descomente e ajuste no .env da VM ---
# COMPOSE_PROFILES=prod
# RESTART_POLICY=unless-stopped
# AIRFLOW_HOME_DIR=/srv/energy-analytics/airflow
# POSTGRES_DIR=/srv/energy-analytics/postgres
# DATA_DIR=/srv/energy-analytics/data
# WAREHOUSE_DIR=/srv/energy-analytics/warehouse
