{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(**/*.p8)",
      "Read(**/*.pem)",
      "Read(./.local/**)",
      "Read(./data/**)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(dbt build *)",
      "Bash(dbt run *)",
      "Bash(dbt seed *)",
      "Bash(python -m ingestion.loaders *)"
    ]
  }
}
